# dependencies
node_modules/

# next.js build output
.next/
out/
build/
dist/

# typescript incremental build metadata
*.tsbuildinfo
next-env.d.ts

# env / secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key

# local file uploads (StorageService local provider writes here at runtime)
.data/uploads/
