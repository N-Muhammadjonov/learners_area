# dependencies
node_modules/

# build output
out/
build/
dist/

# typescript incremental build metadata
*.tsbuildinfo

# env / secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key

# local file uploads (StorageService local provider writes here at runtime)
.data/uploads/
# legacy root: objects used to be written inside public/ (see README, "Storage")
public/uploads/
/public/riwi-speech-assets/

# drizzle local artifacts
drizzle/meta/_journal.json.bak

# logs
*.log
npm-debug.log*
yarn-error.log*

# os metadata
.DS_Store
Thumbs.db

# editor / ide
.idea/
.vscode/
*.swp

# test + tooling caches
coverage/
.eslintcache
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Python backend runtime artifacts
__pycache__/
*.py[cod]
.venv/
!services/backend/app/supabase_root_ca.pem

# Owner-run Safari QA runtime output
/qa/riwi-safari-smoke-last.json
/qa/riwi-safari-conversation-last.json
