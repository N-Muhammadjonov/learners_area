public/uploads/

# drizzle local artifacts
drizzle/meta/_journal.json.bak

# logs
*.log
npm-debug.log*
yarn-error.log*

# os metadata
.DS_Store
Thumbs.db

# editor / ide
.idea/
.vscode/
*.swp

# test + tooling caches
coverage/
.eslintcache
.mypy_cache/
.ruff_cache/
.pytest_cache/
.riwi-jobs/
