{
  "name": "learnersarea-media",
  "main": "index.ts",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "r2_buckets": [{"binding": "MEDIA_BUCKET", "bucket_name": "learners-area"}],
  "observability": {
    "enabled": true,
    "logs": {"enabled": true, "invocation_logs": false, "head_sampling_rate": 1}
  }
}
