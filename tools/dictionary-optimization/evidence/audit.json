    "triggers": [
      {
        "name": "dictionary_terms_immutable",
        "table": "dictionary_search_terms",
        "enabled": "O",
        "function": "dictionary_immutable_release",
        "definition": "CREATE TRIGGER dictionary_terms_immutable BEFORE INSERT OR DELETE OR UPDATE ON public.dictionary_search_terms FOR EACH ROW EXECUTE FUNCTION dictionary_immutable_release()",
        "functionBody": "CREATE OR REPLACE FUNCTION public.dictionary_immutable_release()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n IF EXISTS(SELECT 1 FROM dictionary_releases WHERE id IN (OLD.release_id,NEW.release_id)\n  AND (state='validated' OR (state='retired' AND TG_OP<>'DELETE')))\n THEN RAISE EXCEPTION 'immutable_dictionary_release'; END IF;\n RETURN CASE WHEN TG_OP='DELETE' THEN OLD ELSE NEW END;\nEND $function$\n"
      }
    ],
