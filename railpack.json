{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.14"
  },
  "steps": {
    "build": {
      "inputs": [
        {
          "step": "install"
        },
        {
          "local": true,
          "include": [
            "."
          ]
        }
      ],
      "commands": [
        "python3 scripts/build_native_assets.py"
      ]
    }
  },
  "deploy": {
    "inputs": [
      "...",
      {
        "step": "build",
        "include": [
          "."
        ]
      }
    ],
    "aptPackages": [
      "libicu-dev"
    ],
    "variables": {
      "HOST": "0.0.0.0",
      "APP_ENV": "production"
    },
    "startCommand": "python3 scripts/serve.py"
  }
}
