{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "fix/dictionary-audit-phase-01-20261112": false
    }
  },
  "regions": [
    "sin1"
  ],
  "framework": "fastapi",
  "buildCommand": "python3 scripts/build_native_assets.py",
  "functions": {
    "server.py": {
      "includeFiles": "{services/backend/app/**,services/backend/contracts/**,services/backend/assets/**,frontend/vanilla/build/**}",
      "excludeFiles": "{node_modules,.next,src,tests,docs,scripts,content,data,reference,workers,public,drizzle,services/{telegram-bot,live-signal,backend/tests},frontend/vanilla/{js,modules,css,campus,fonts,brand,images,tests,docs,scripts,deliverables,build/**/parts}}/**"
    }
  },
  "headers": [
    {
      "source": "/riwi-speech-assets/parts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
