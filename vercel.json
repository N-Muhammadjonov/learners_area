{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "framework": "fastapi",
  "buildCommand": "python3 scripts/build_native_assets.py",
  "functions": {
    "server.py": {
      "includeFiles": "{services/backend/app/**,services/backend/contracts/**,services/backend/assets/**,frontend/vanilla/build/**}",
      "excludeFiles": "{node_modules,.next,src,tests,docs,scripts,content,data,reference,workers,public,drizzle,services/{telegram-bot,live-signal,backend/tests},frontend/vanilla/{js,modules,css,campus,fonts,brand,images,tests,docs,scripts,node_modules,deliverables}}/**"
    }
  }
}
