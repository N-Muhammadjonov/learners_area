{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "framework": "fastapi",
  "buildCommand": "python3 scripts/build_native_assets.py",
  "functions": {
    "server.py": {
      "includeFiles": "{services/backend/app/**,services/backend/assets/**,frontend/vanilla/build/**}",
      "excludeFiles": "{node_modules/**,.next/**,src/**,tests/**,docs/**,frontend/vanilla/tests/**,frontend/vanilla/docs/**,frontend/vanilla/scripts/**,frontend/vanilla/node_modules/**,services/backend/tests/**,scripts/**,content/**,data/**,reference/**,workers/**,public/**,drizzle/**,services/telegram-bot/**,services/live-signal/**,frontend/vanilla/js/**,frontend/vanilla/modules/**,frontend/vanilla/css/**,frontend/vanilla/campus/**,frontend/vanilla/fonts/**,frontend/vanilla/brand/**,frontend/vanilla/images/**,frontend/vanilla/deliverables/**}"
    }
  }
}
