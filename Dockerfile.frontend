FROM node:24-bookworm-slim AS build
WORKDIR /srv/frontend
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:24-bookworm-slim
WORKDIR /srv/frontend
ENV NODE_ENV=production BACKEND_MANAGED=external
COPY --from=build /srv/frontend/node_modules ./node_modules
COPY --from=build /srv/frontend/.next ./.next
COPY --from=build /srv/frontend/public ./public
COPY --from=build /srv/frontend/package.json /srv/frontend/next.config.mjs ./
COPY --from=build /srv/frontend/scripts/run-with-backend.mjs ./scripts/run-with-backend.mjs
COPY --from=build /srv/frontend/src/lib/nav/ ./src/lib/nav/
EXPOSE 3000
CMD ["npm", "start"]
