# ============================================================================
# Learners Area — environment template
# ============================================================================
# Copy to .env and fill in real values:   cp .env.example .env
# NEVER commit .env. Every secret below must stay out of Git.
# Never prefix a secret with NEXT_PUBLIC_ — that inlines it into the browser
# bundle where anyone can read it.
# ============================================================================

# --- Core -------------------------------------------------------------------
# Postgres connection string, e.g. postgres://user:pass@localhost:5432/learners_area
DATABASE_URL=

# Signs session JWTs. Generate: openssl rand -base64 48
# Minimum 16 characters. Rotating it invalidates every existing session.
AUTH_SECRET=

# Canonical production origin. Set the actual deployed origin; do not include a path.
# It is never inferred from a randomly generated preview hostname.
PUBLIC_BASE_URL=
# Legacy alias only; leave empty on new deployments. PUBLIC_BASE_URL wins.
NEXT_PUBLIC_APP_URL=
# development | preview | production. VERCEL_ENV is a fallback on Vercel.
# Set preview explicitly on another provider's preview deployment.
APP_ENV=
# Optional portable build identity shown by /api/version.
APP_COMMIT_SHA=
APP_REGION=
# Set true only behind a trusted proxy that OVERWRITES forwarded Host/Proto.
# Default: false on plain Node; Vercel's managed proxy is recognized.
TRUST_PROXY_HEADERS=
# Local next dev only. Never exposes reset tokens under next start/production.
ALLOW_DEV_RESET_LINKS=false

# Extra origins that may send state-changing requests (the CSRF origin check).
# Comma-separated. The public base URL is trusted automatically; the hosted
# preview needs its own origin here only if it also POSTs to your deployment.
TRUSTED_ORIGINS=

# Exact origins allowed to EMBED the app in an iframe, comma-separated.
# Default is self only on every host. Explicitly allow an intended preview shell.
ALLOWED_FRAME_ANCESTORS=

# Extra origins the browser may connect to (fetch/XHR/media), comma-separated.
# Direct-to-R2 uploads already add R2_ENDPOINT automatically; add anything else
# you integrate (a CDN, a telemetry endpoint) here rather than loosening the CSP.
CSP_CONNECT_SRC=

# --- Storage ----------------------------------------------------------------
# Which StorageService implementation to use:
#   local  — writes to ./.data/uploads and serves through /api/resources.
#            Fine for development and single-node self-hosting. NOT usable on
#            hosts with an ephemeral/read-only filesystem (Vercel, most
#            serverless targets).
#   r2     — Cloudflare R2 (S3-compatible). REQUIRED for production.
#   s3     — generic S3-compatible bucket (AWS S3, MinIO, DO Spaces, ...).
# Missing production configuration or an unknown provider fails closed.
STORAGE_PROVIDER=local

# Where the `local` provider puts objects. Deliberately outside `public/`: Next
# serves everything in `public/` as a static file, so an object there would be
# readable by anyone holding the key, with no session. Leave it unset for the
# default (`.data/uploads`), or point it at a mounted volume on a self-hosted box.
# STORAGE_LOCAL_DIR=

# --- Cloudflare R2 (production storage) -------------------------------------
# Set these when STORAGE_PROVIDER=r2. R2 is S3-compatible, so the app uses the
# AWS SDK's SigV4 signer against R2's endpoint — this is not a mistake.
# Create a token scoped to ONE bucket with Object Read & Write (not Admin).
R2_ACCOUNT_ID=            # 32-char account id from the Cloudflare dashboard
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=             # https://<account-id>.r2.cloudflarestorage.com
# Region is always "auto" for R2 — kept for S3-API compatibility.
R2_REGION=auto

# --- Generic S3-compatible storage ------------------------------------------
# Read when STORAGE_PROVIDER=s3. Also honoured as a fallback for r2, so an
# existing S3_* configuration keeps working unchanged.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# PRIVATE-BY-DEFAULT: Learners Area keeps its bucket private. There is
# deliberately no "public URL base" variable. Files are delivered through
# GET /api/resources/<objectKey>, which authenticates the caller, checks they
# may read that object, then issues a short-lived signed GET URL. Only set a
# public base if you intentionally front a bucket of public marketing assets
# with a CDN — course content must never be served from it.
# S3_PUBLIC_URL_BASE=      # intentionally unsupported, see above

# --- Upload policy ----------------------------------------------------------
# Centralised in src/lib/validation/uploads.ts; these only override the
# global ceilings so ops can tune them per deployment without a code change.
MAX_UPLOAD_MB=50
MAX_IMAGE_UPLOAD_MB=10
MAX_AUDIO_UPLOAD_MB=50
MAX_FILE_UPLOAD_MB=50

# --- Brand ------------------------------------------------------------------
# The six approved artwork files live in public/brand/ and their paths are
# written down once, in src/lib/config/brand.ts. They are code, not environment:
# a rename is a one-line change there, never a new variable here, and never a
# generated or recoloured substitute for the approved file.
# Display strings only — these can be rebranded without touching routes,
# database relations, evaluations or stored history.
NEXT_PUBLIC_SITE_NAME=Learners Area
NEXT_PUBLIC_SITE_SHORT_NAME=Learners Area
NEXT_PUBLIC_TAGLINE=Bilingual IELTS preparation inside a private centre.
# The line under the product name in the sidebar brand block.
NEXT_PUBLIC_BRAND_LINE=Take your learning journey with us
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_TELEGRAM_CONTACT=

# --- Telegram login (optional) ----------------------------------------------
# Without both of these the "Continue with Telegram" button renders disabled
# rather than faking a successful login.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Google sign-in (OIDC). Leave empty to hide the button. Redirect URI must be
# registered in Google Cloud exactly: <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- AI Coach: provider architecture ----------------------------------------
# RIWI is the built-in evaluator. It needs NO credentials and works offline, and
# it is also the automatic fallback whenever a configured external provider
# fails, times out, is rate limited or returns a response that does not match
# the evaluation contract.
#
# Switching evaluators never requires a code change in any service, route, page
# or database column:
#   1. implement an adapter under src/lib/services/coach/providers/<vendor>/
#   2. register it in src/lib/services/coach/providers/index.ts
#   3. set its credentials in the environment (names of your choosing — each
#      adapter declares the variable names it reads in `requiredSecrets`)
#   4. point AI_PRIMARY_PROVIDER at its id
# The result always records the provider that actually produced it, so the UI
# shows "Checked by RIWI" or "Checked by <that provider>", never a guess.
AI_PRIMARY_PROVIDER=riwi

# Master switch for calling any third party. Set to false to keep every
# evaluation internal even while an external provider is configured.
AI_EXTERNAL_ENABLED=true

# Provider execution limits (milliseconds / attempts). Retries only apply to
# transient failures; a malformed response falls back immediately.
AI_PROVIDER_TIMEOUT_MS=20000
AI_PROVIDER_MAX_ATTEMPTS=2
AI_PROVIDER_RETRY_BACKOFF_MS=200

# --- Abuse limits -----------------------------------------------------------
# One sliding window per action, enforced in the middleware. The defaults are
# listed in src/lib/http/rate-limit.ts; each can be overridden without a code
# change with RATE_LIMIT_<ACTION_NAME>, e.g.
#   RATE_LIMIT_LOGIN_ACCOUNT=8     failed sign-ins per account / 15 min
#   RATE_LIMIT_LOGIN_IP=40         failed sign-ins per IP / 15 min
#   RATE_LIMIT_REGISTER=10         registrations per IP / hour
#   RATE_LIMIT_PASSWORD_RESET=5    reset requests / 15 min
#   RATE_LIMIT_ADMISSION_REQUEST=10 admission applications / hour
#   RATE_LIMIT_TELEGRAM_AUTH=20    Telegram sign-ins / 15 min
#   RATE_LIMIT_EVALUATION=60       evaluations / 15 min
#   RATE_LIMIT_UPLOAD_INTENT=120   presigned upload intents / 15 min
#   RATE_LIMIT_VOCABULARY_SEARCH=300 vocabulary searches / minute
# Only FAILED sign-ins count against a login limit, so a forgotten password
# cannot lock a real learner out.

# --- Retention --------------------------------------------------------------
# DataRetentionService (src/lib/services/retention.ts) reads every window from
# the environment; the numbers below are its defaults. Nothing here deletes
# course content, and an active student is never removed because their account
# is old: inactivity is measured on real work, not on sign-ins.
RETENTION_INACTIVE_STUDENT_MONTHS=6   # scrub personal data, keep the record
RETENTION_RAW_EVENT_MONTHS=2           # raw operational events + read notices
RETENTION_STRUCTURED_MONTHS=18         # evaluations, old work, recordings
RETENTION_AUDIT_MONTHS=18              # security/audit trail
RETENTION_EXPORT_DAYS=7                # generated export files
RETENTION_BATCH_SIZE=500               # rows per delete statement

# --- One-time owner bootstrap (scripts only) --------------------------------
# Used by `node scripts/bootstrap-owner.mjs --email ...`; never read by the app
# itself, and never a way to log in. Remove them from the environment once the
# owner exists. There is no OWNER_EMAIL constant anywhere in the code.
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Speech-to-text (separate subsystem, separate provider) -----------------
# Deliberately independent of AI_PRIMARY_PROVIDER: transcription and evaluation
# are different jobs and are frequently different vendors. `none` means the app
# says "no transcript provider is configured" instead of inventing a transcript.
# A student can still type their own transcript, which is stored and labelled as
# typed by them.
STT_PRIMARY_PROVIDER=none

# --- Feature flags ----------------------------------------------------------
# Commercial launch is not active. Billing has schema but no UI.
BILLING_ENABLED=false
PUBLIC_PAYMENT_ENABLED=false
# Deprecated as an evaluation switch: use AI_PRIMARY_PROVIDER instead. Kept so
# existing deployments keep parsing their environment; it no longer influences
# which evaluator runs.
REAL_AI_ENABLED=false
# The platform is multi-course but only IELTS content exists so far.
SAT_ENABLED=false

# Console-only browser timings, explicit QA opt-in; ignored on production deployments.
PERFORMANCE_DIAGNOSTICS=

# --- Live Partner realtime (see services/live-signal/README.md) -------------
# Without ALL of these AND a reachable signalling /healthz, Go Online is refused.
LIVE_PARTNER_SIGNAL_URL=
LIVE_PARTNER_SIGNAL_SECRET=
LIVE_PARTNER_TURN_URLS=
LIVE_PARTNER_TURN_SECRET=
# Owner-authorised direct media host for the custom TED/PODCAST player (https origin). Only licensed media.
AUTHORIZED_MEDIA_ORIGIN=

# Optional paid OpenAI adapters. Disabled until explicitly selected.
# Server-only credentials; select models supported by your own account.
OPENAI_API_KEY=
OPENAI_EVALUATION_MODEL=
OPENAI_STT_MODEL=
# AI_PRIMARY_PROVIDER=openai
# STT_PRIMARY_PROVIDER=openai
# AI_EXTERNAL_ENABLED=true
