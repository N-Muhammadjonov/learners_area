# ============================================================================
# Learners Area — environment template
# ============================================================================
# Copy to .env and fill in real values:   cp .env.example .env
# NEVER commit .env. Every secret below must stay out of Git.
# Never prefix a secret with NEXT_PUBLIC_ — that inlines it into the browser
# bundle where anyone can read it.
# ============================================================================

# --- Core -------------------------------------------------------------------
# Postgres connection string, e.g. postgres://user:pass@localhost:5432/learners_area
DATABASE_URL=

# Signs session JWTs. Generate: openssl rand -base64 48
# Minimum 16 characters. Rotating it invalidates every existing session.
AUTH_SECRET=

# Public origin of the app. Used to build absolute URLs where needed.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Storage ----------------------------------------------------------------
# Which StorageService implementation to use:
#   local  — writes to ./public/uploads and serves through /api/resources.
#            Fine for development and single-node self-hosting. NOT usable on
#            hosts with an ephemeral/read-only filesystem (Vercel, most
#            serverless targets).
#   r2     — Cloudflare R2 (S3-compatible). REQUIRED for production.
#   s3     — generic S3-compatible bucket (AWS S3, MinIO, DO Spaces, ...).
# Anything else falls back to `local` with a console warning.
STORAGE_PROVIDER=local

# --- Cloudflare R2 (production storage) -------------------------------------
# Set these when STORAGE_PROVIDER=r2. R2 is S3-compatible, so the app uses the
# AWS SDK's SigV4 signer against R2's endpoint — this is not a mistake.
# Create a token scoped to ONE bucket with Object Read & Write (not Admin).
R2_ACCOUNT_ID=            # 32-char account id from the Cloudflare dashboard
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=             # https://<account-id>.r2.cloudflarestorage.com
# Region is always "auto" for R2 — kept for S3-API compatibility.
R2_REGION=auto

# --- Generic S3-compatible storage ------------------------------------------
# Read when STORAGE_PROVIDER=s3. Also honoured as a fallback for r2, so an
# existing S3_* configuration keeps working unchanged.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# PRIVATE-BY-DEFAULT: Learners Area keeps its bucket private. There is
# deliberately no "public URL base" variable. Files are delivered through
# GET /api/resources/<objectKey>, which authenticates the caller, checks they
# may read that object, then issues a short-lived signed GET URL. Only set a
# public base if you intentionally front a bucket of public marketing assets
# with a CDN — course content must never be served from it.
# S3_PUBLIC_URL_BASE=      # intentionally unsupported, see above

# --- Upload policy ----------------------------------------------------------
# Centralised in src/lib/validation/uploads.ts; these only override the
# global ceilings so ops can tune them per deployment without a code change.
MAX_UPLOAD_MB=50
MAX_IMAGE_UPLOAD_MB=10
MAX_AUDIO_UPLOAD_MB=50
MAX_FILE_UPLOAD_MB=50

# --- Telegram login (optional) ----------------------------------------------
# Without both of these the "Continue with Telegram" button renders disabled
# rather than faking a successful login.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- AI Coach: provider architecture ----------------------------------------
# RIWI is the built-in evaluator. It needs NO credentials and works offline, and
# it is also the automatic fallback whenever a configured external provider
# fails, times out, is rate limited or returns a response that does not match
# the evaluation contract.
#
# Switching evaluators never requires a code change in any service, route, page
# or database column:
#   1. implement an adapter under src/lib/services/coach/providers/<vendor>/
#   2. register it in src/lib/services/coach/providers/index.ts
#   3. set its credentials in the environment (names of your choosing — each
#      adapter declares the variable names it reads in `requiredSecrets`)
#   4. point AI_PRIMARY_PROVIDER at its id
# The result always records the provider that actually produced it, so the UI
# shows "Checked by RIWI" or "Checked by <that provider>", never a guess.
AI_PRIMARY_PROVIDER=riwi

# Master switch for calling any third party. Set to false to keep every
# evaluation internal even while an external provider is configured.
AI_EXTERNAL_ENABLED=true

# Provider execution limits (milliseconds / attempts). Retries only apply to
# transient failures; a malformed response falls back immediately.
AI_PROVIDER_TIMEOUT_MS=20000
AI_PROVIDER_MAX_ATTEMPTS=2
AI_PROVIDER_RETRY_BACKOFF_MS=200

# --- Speech-to-text (separate subsystem, separate provider) -----------------
# Deliberately independent of AI_PRIMARY_PROVIDER: transcription and evaluation
# are different jobs and are frequently different vendors. `none` means the app
# says "no transcript provider is configured" instead of inventing a transcript.
# A student can still type their own transcript, which is stored and labelled as
# typed by them.
STT_PRIMARY_PROVIDER=none

# --- Feature flags ----------------------------------------------------------
# Commercial launch is not active. Billing has schema but no UI.
BILLING_ENABLED=false
PUBLIC_PAYMENT_ENABLED=false
# Deprecated as an evaluation switch: use AI_PRIMARY_PROVIDER instead. Kept so
# existing deployments keep parsing their environment; it no longer influences
# which evaluator runs.
REAL_AI_ENABLED=false
# The platform is multi-course but only IELTS content exists so far.
SAT_ENABLED=false
