{
  "name": "learners-area",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "node --conditions=react-server --env-file=.env --import tsx src/db/seed.ts",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "db:migrate": "drizzle-kit migrate",
    "reading:import": "node --import tsx --env-file=.env scripts/import-reading-105.mjs",
    "test:ui": "TSX_TSCONFIG_PATH=tests/ui/tsconfig.json node --import tsx --test tests/ui/*.test.tsx",
    "qa:pg": "bash scripts/qa2-local-postgres.sh",
    "qa:gate": "bash scripts/qa-forensic-gate.sh",
    "qa:riwi-resources": "node --conditions=react-server --import tsx scripts/riwi-resource-leak-scan.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1137.0",
    "bcryptjs": "2.4.3",
    "drizzle-orm": "^0.45.3",
    "fflate": "0.8.2",
    "jose": "5.9.6",
    "nanoid": "6.0.1",
    "next": "^15.5.26",
    "pdfjs-dist": "6.3.289",
    "pg": "8.13.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcryptjs": "2.4.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "20.16.11",
    "@types/pg": "8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "^0.31.11",
    "eslint": "8.57.1",
    "eslint-config-next": "^15.5.26",
    "jsdom": "^30.1.1",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.14",
    "tsx": "^4.23.15",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": "24.x"
  }
}
